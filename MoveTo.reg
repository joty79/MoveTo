Windows Registry Editor Version 5.00

; ======== CLEANUP ========
[-HKEY_CURRENT_USER\Software\Classes\*\shell\MoveToCustom]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\MoveToCustom]
[-HKEY_CURRENT_USER\Software\Classes\*\shell\Z_MoveTo]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\Z_MoveTo]

; ======== MOVE TO FOR FILES ========
[HKEY_CURRENT_USER\Software\Classes\*\shell\Z_MoveTo]
"MUIVerb"="Move To"
"Icon"="shell32.dll,-16761"
"SubCommands"=""

[HKEY_CURRENT_USER\Software\Classes\*\shell\Z_MoveTo\shell]

; Edit destinations (always last)
[HKEY_CURRENT_USER\Software\Classes\*\shell\Z_MoveTo\shell\zzz_Edit]
"MUIVerb"="[Edit destinations]"
"Icon"="shell32.dll,-16710"
; Hex 20 = Separator Before
"CommandFlags"=dword:00000020

[HKEY_CURRENT_USER\Software\Classes\*\shell\Z_MoveTo\shell\zzz_Edit\command]
@="wscript.exe \"D:\\Users\\joty79\\scripts\\MoveTo\\EditDestinations.vbs\""

; ======== MOVE TO FOR FOLDERS ========
[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Z_MoveTo]
"MUIVerb"="Move To"
"Icon"="shell32.dll,-16761"
"SubCommands"=""

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Z_MoveTo\shell]

; Add as destination (only for folders)
[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Z_MoveTo\shell\yyy_Add]
"MUIVerb"="[Add as destination]"
"Icon"="shell32.dll,-16769"
; Hex 20 = Separator Before (Separates this from the folders above it)
"CommandFlags"=dword:00000020

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Z_MoveTo\shell\yyy_Add\command]
@="wscript.exe \"D:\\Users\\joty79\\scripts\\MoveTo\\AddMoveToDestination.vbs\" \"%1\""

; Edit destinations
[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Z_MoveTo\shell\zzz_Edit]
"MUIVerb"="[Edit destinations]"
"Icon"="shell32.dll,-16710"
; No separator needed here (it will sit tightly under 'Add')

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Z_MoveTo\shell\zzz_Edit\command]
@="wscript.exe \"D:\\Users\\joty79\\scripts\\MoveTo\\EditDestinations.vbs\""