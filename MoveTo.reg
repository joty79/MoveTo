Windows Registry Editor Version 5.00

; ======== CLEANUP ========
[-HKEY_CURRENT_USER\Software\Classes\*\shell\MoveToCustom]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\MoveToCustom]
[-HKEY_CURRENT_USER\Software\Classes\*\shell\Z_MoveTo]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\Z_MoveTo]

; ======== MOVE TO FOR FILES ========
[HKEY_CURRENT_USER\Software\Classes\*\shell\Z_MoveTo]
"MUIVerb"="Move To"
"Icon"="shell32.dll,-16761"
"SubCommands"=""

[HKEY_CURRENT_USER\Software\Classes\*\shell\Z_MoveTo\shell]

; Actions submenu (always visible even with many destinations)
[HKEY_CURRENT_USER\Software\Classes\*\shell\Z_MoveTo\shell\aaa_Actions]
"MUIVerb"="[Actions]"
"Icon"="shell32.dll,-16710"
"SubCommands"=""

[HKEY_CURRENT_USER\Software\Classes\*\shell\Z_MoveTo\shell\aaa_Actions\shell]

[HKEY_CURRENT_USER\Software\Classes\*\shell\Z_MoveTo\shell\aaa_Actions\shell\zz_Edit]
"MUIVerb"="[Edit destinations]"
"Icon"="shell32.dll,-16710"

[HKEY_CURRENT_USER\Software\Classes\*\shell\Z_MoveTo\shell\aaa_Actions\shell\zz_Edit\command]
@="wscript.exe \"D:\\Users\\joty79\\scripts\\MoveTo\\EditDestinations.vbs\""

; ======== MOVE TO FOR FOLDERS ========
[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Z_MoveTo]
"MUIVerb"="Move To"
"Icon"="shell32.dll,-16761"
"SubCommands"=""

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Z_MoveTo\shell]

; Actions submenu (always visible even with many destinations)
[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Z_MoveTo\shell\aaa_Actions]
"MUIVerb"="[Actions]"
"Icon"="shell32.dll,-16710"
"SubCommands"=""

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Z_MoveTo\shell\aaa_Actions\shell]

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Z_MoveTo\shell\aaa_Actions\shell\yy_Add]
"MUIVerb"="[Add as destination]"
"Icon"="shell32.dll,-16769"

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Z_MoveTo\shell\aaa_Actions\shell\yy_Add\command]
@="wscript.exe \"D:\\Users\\joty79\\scripts\\MoveTo\\AddMoveToDestination.vbs\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Z_MoveTo\shell\aaa_Actions\shell\zz_Edit]
"MUIVerb"="[Edit destinations]"
"Icon"="shell32.dll,-16710"

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\Z_MoveTo\shell\aaa_Actions\shell\zz_Edit\command]
@="wscript.exe \"D:\\Users\\joty79\\scripts\\MoveTo\\EditDestinations.vbs\""
